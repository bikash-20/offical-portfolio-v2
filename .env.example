# OpenRouter API key for the Opus AI assistant.
# Get a free key at https://openrouter.ai (free Llama 3.1 8B / Gemini Flash / Mistral 7B models available).
# When left blank, the chat UI shows a "not configured" hint.
VITE_OPENROUTER_API_KEY=

# EmailJS — only used if you want the contact form to send real emails.
# Otherwise the form falls back to opening the user's email client with a mailto: link.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: override the GitHub/LeetCode/Codeforces handles used by the dashboard.
VITE_GITHUB_HANDLE=bikash-20
VITE_LEETCODE_HANDLE=bikashtalukder
VITE_CODEFORCES_HANDLE=
